#extension GL_EXT_nonuniform_qualifier : enable

#include "defines.h"
#include "utils.h"
#include "common_structures.h"
#include "volumetrics/common.h"

layout(set = 0, binding = 0, rgba16f) uniform writeonly image2D g_Result; // rgb - in-scattered light, a - transmittance
layout(set = 0, binding = 1, r32f) uniform writeonly image2D g_ResultDepth;
layout(set = 0, binding = 2) uniform sampler2D g_DepthTexture;
layout(set = 0, binding = 3) buffer IndirectArgs
{
    uvec4 g_DispatchArgs;
};

layout(set = 1, binding = 0)
readonly buffer PointLightsBuffer
{
    PointLight g_PointLights[];
};

layout(set = 1, binding = 1)
readonly buffer SpotLightsBuffer
{
    SpotLight g_SpotLights[];
};

layout(set = 1, binding = 2)
readonly buffer PointLightsBucketsBuffer
{
	uint g_PointLightsBuckets[];
};

layout(set = 1, binding = 3)
readonly buffer SpotLightsBucketsBuffer
{
	uint g_SpotLightsBuckets[];
};

layout(set = 1, binding = 4)
uniform LightsCounterBuffer
{
	uint g_PointLightsCount;
	uint g_SpotLightsCount;
};

layout(set = 1, binding = 5)
readonly buffer DirectionalLightBuffer
{
    DirectionalLight g_DirectionalLight;
};

layout(set = 1, binding = 6)
uniform CameraView
{
    mat4 g_CameraView;
    mat4 g_ViewProjInv;
    mat4 g_ViewProj;
    mat4 g_PrevViewProj;
    mat4 g_Proj;
    mat4 g_ProjInv;
};

layout(set = 1, binding = 7)
readonly buffer LightMatricesBuffer
{
	mat4 g_LightMatrices[];
};

layout(set = 2, binding = 0) uniform sampler2DShadow   g_DirShadowMaps[EG_CASCADES_COUNT];
layout(set = 3, binding = 0) uniform samplerCubeShadow g_PointShadowMaps[];
layout(set = 4, binding = 0) uniform sampler2DShadow   g_SpotShadowMaps[];

#ifdef EG_TRANSLUCENT_SHADOWS
layout(set = 5, binding = 0) uniform sampler2D   g_DirShadowMapsColored[EG_CASCADES_COUNT];
layout(set = 6, binding = 0) uniform samplerCube g_PointShadowMapsColored[];
layout(set = 7, binding = 0) uniform sampler2D   g_SpotShadowMapsColored[];

layout(set = 8, binding = 0)  uniform sampler2D   g_DirShadowMapsColoredDepth[EG_CASCADES_COUNT];
layout(set = 9, binding = 0)  uniform samplerCube g_PointShadowMapsColoredDepth[];
layout(set = 10, binding = 0) uniform sampler2D   g_SpotShadowMapsColoredDepth[];
#endif

layout(push_constant) uniform PushConstants
{
    vec3 g_CameraPos;
    float g_VolumetricMaxDistance;
    ivec2 g_Size;
    float g_Time;
    uint g_DownscaleFactor;
    vec3 g_FogAlbedo;
    float g_FogAnisotropy;
    uint g_TilesBufferWidth;
    uint g_HasDirLight;
    float g_Density;
};

layout(constant_id = 0) const uint s_VolumetricSamples = 20;

#define EG_PIXEL_COORDS vec2(gl_GlobalInvocationID)
#include "volumetrics/utils.h"

#define GROUP_SIZE 8
layout(local_size_x = GROUP_SIZE, local_size_y = GROUP_SIZE) in;

// Selects the full-res pixel (out of the ones covered by this low-res pixel) that the ray is traced to.
// The closest and the farthest pixels are selected in a checkerboard pattern. That way, both, foreground & background surfaces
// are represented in the low-res result at depth discontinuities, which is what the depth-aware blur & upsampling rely on.
ivec2 SelectFullResPixel(ivec2 pixelCoords, out float outDepth)
{
    const ivec2 fullResSize = textureSize(g_DepthTexture, 0);
    const bool bSelectClosest = ((pixelCoords.x + pixelCoords.y) & 1) == 0;
    pixelCoords = pixelCoords * int(g_DownscaleFactor);

    ivec2 selectedPixel = min(pixelCoords, fullResSize - 1);
    float selectedDepth = texelFetch(g_DepthTexture, selectedPixel, 0).x;
    for (int y = 0; y < int(g_DownscaleFactor); ++y)
    {
        for (int x = 0; x < int(g_DownscaleFactor); ++x)
        {
            const ivec2 pixel = min(pixelCoords + ivec2(x, y), fullResSize - 1);
            const float depth = texelFetch(g_DepthTexture, pixel, 0).x;
            const float closer = (depth - selectedDepth) * (EG_DEPTH_NEAR - EG_DEPTH_FAR);
            if (bSelectClosest ? (closer > 0.f) : (closer < 0.f))
            {
                selectedPixel = pixel;
                selectedDepth = depth;
            }
        }
    }

    outDepth = selectedDepth;
    return selectedPixel;
}

void main()
{
    const ivec2 pixelCoords = ivec2(gl_GlobalInvocationID);
    if (pixelCoords.x >= g_Size.x || pixelCoords.y >= g_Size.y)
        return;

    float depth;
    const ivec2 fullResPixel = SelectFullResPixel(pixelCoords, depth);
    const vec2 uv = (vec2(fullResPixel) + 0.5f) / vec2(textureSize(g_DepthTexture, 0));
    const vec3 worldPos = WorldPosFromDepth(g_ViewProjInv, uv, depth);
    const float rayOffset = GetRayMarchOffset(pixelCoords);

    vec3 Lo = vec3(0.f);

    // Light culling tiles are in full-res
    const uvec2 tileID = uvec2(fullResPixel) / EG_LIGHT_CULLING_TILE_SIZE;
    const uint tileIndex = tileID.x + tileID.y * g_TilesBufferWidth;
    const uint bucketStartIndex = tileIndex * EG_LIGHTS_BUCKET_COUNT;

    // PointLights
    const uint pointLightsBucketsCount = g_PointLightsCount > 0 ? min(EG_LIGHTS_BUCKET_COUNT, ((g_PointLightsCount - 1) / EG_LIGHT_BUCKET_SIZE) + 1) : 0u;
    for (uint bucket = 0; bucket < pointLightsBucketsCount; bucket++)
    {
        uint bucketBits = g_PointLightsBuckets[bucketStartIndex + bucket];
        while(bucketBits > 0)
        {
            const uint bucketLightIndex = findLSB(bucketBits);
            const uint lightIndex = EG_LIGHT_BUCKET_SIZE * bucket + bucketLightIndex;
            bucketBits ^= (1 << bucketLightIndex);

            const PointLight pointLight = g_PointLights[lightIndex];
	        const bool bVolumetricLight = pointLight.VolumetricFogIntensity < 0;
	        if (!bVolumetricLight)
		        continue;

            const bool bCastsShadows = (pointLight.Radius2 < 0) && (pointLight.ShadowMapIndex < EG_MAX_LIGHT_SHADOW_MAPS);
            const uint shadowMapIndex = bCastsShadows ? pointLight.ShadowMapIndex : 0u;

            Lo += PointLight_Volumetric(pointLight, g_PointShadowMaps[nonuniformEXT(shadowMapIndex)],
#ifdef EG_TRANSLUCENT_SHADOWS
                g_PointShadowMapsColored[nonuniformEXT(shadowMapIndex)], g_PointShadowMapsColoredDepth[nonuniformEXT(shadowMapIndex)],
#endif
                worldPos, g_CameraPos, s_VolumetricSamples, g_VolumetricMaxDistance, rayOffset, bCastsShadows);
        }
    }

    // SpotLights
    const uint spotLightsBucketsCount = g_SpotLightsCount > 0 ? min(EG_LIGHTS_BUCKET_COUNT, ((g_SpotLightsCount - 1) / EG_LIGHT_BUCKET_SIZE) + 1) : 0u;
    for (uint bucket = 0; bucket < spotLightsBucketsCount; bucket++)
    {
        uint bucketBits = g_SpotLightsBuckets[bucketStartIndex + bucket];
        while(bucketBits > 0)
        {
            const uint bucketLightIndex = findLSB(bucketBits);
            const uint lightIndex = EG_LIGHT_BUCKET_SIZE * bucket + bucketLightIndex;
            bucketBits ^= (1 << bucketLightIndex);

            const SpotLight spotLight = g_SpotLights[lightIndex];
	        const bool bVolumetricLight = spotLight.VolumetricFogIntensity < 0;
	        if (!bVolumetricLight)
		        continue;

            const bool bCastsShadows = (spotLight.bCastsShadows != 0) && (spotLight.ShadowMapIndex < EG_MAX_LIGHT_SHADOW_MAPS);
            const uint shadowMapIndex = bCastsShadows ? spotLight.ShadowMapIndex : 0u;

            Lo += SpotLight_Volumetric(spotLight, g_SpotShadowMaps[nonuniformEXT(shadowMapIndex)],
#ifdef EG_TRANSLUCENT_SHADOWS
                g_SpotShadowMapsColored[nonuniformEXT(shadowMapIndex)], g_SpotShadowMapsColoredDepth[nonuniformEXT(shadowMapIndex)],
#endif
                worldPos, g_CameraPos, s_VolumetricSamples, g_VolumetricMaxDistance, rayOffset, bCastsShadows);
        }
    }

    if (g_HasDirLight != 0)
    {
	    const bool bVolumetricLight = g_DirectionalLight.VolumetricFogIntensity < 0;
	    if (bVolumetricLight)
        {
            const vec3 incoming = normalize(-g_DirectionalLight.Direction);
            Lo += DirectionalLight_Volumetric(g_DirectionalLight, g_DirShadowMaps,
#ifdef EG_TRANSLUCENT_SHADOWS
                g_DirShadowMapsColored, g_DirShadowMapsColoredDepth,
#endif
                worldPos, g_CameraPos, incoming, g_CameraView, s_VolumetricSamples, g_VolumetricMaxDistance, rayOffset);
        }
    }

    // Scattering coef
    Lo *= g_FogAlbedo * g_Density;

    const float transmittance = Transmittance(min(distance(worldPos, g_CameraPos), g_VolumetricMaxDistance));

    imageStore(g_Result, pixelCoords, vec4(Lo, transmittance));
    imageStore(g_ResultDepth, pixelCoords, vec4(Volumetric_GetLinearDepth(g_ProjInv, uv, depth)));

    if (any(greaterThan(Lo, vec3(0))) || transmittance < 1.f)
    {
        // We just need an indication that we have something on the screen that's worth applying
        g_DispatchArgs.x = 1;
    }
}
