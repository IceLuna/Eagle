#include "defines.h"

// Resolves the 4x4 ray-march dither pattern (see `GetRayMarchOffset()` in `volumetric_utils.h`).
// The kernel is the separable 5-tap filter [1 2 2 2 1] / 8, applied in both directions.
// Its two outermost taps are 4 pixels apart, i.e. they belong to the same dither phase, so together they weigh as much as any of the inner taps.
// As a result, each of the 16 phases of the 4x4 pattern ((x mod 4, y mod 4) pairs) receives exactly the same total weight (1/16),
// which cancels the pattern exactly while keeping the filter centered and as narrow as possible.

layout(push_constant) uniform PushConstants
{
    ivec2 g_Size;
    vec2 g_TexelSize;
};

#define GROUP_SIZE 8
#define KERNEL_RADIUS 2
#define KERNEL_SIZE (2 * KERNEL_RADIUS + 1)
#define TILE_SIZE (GROUP_SIZE + 2 * KERNEL_RADIUS)
layout(local_size_x = GROUP_SIZE, local_size_y = GROUP_SIZE) in;

layout(set = 0, binding = 0) uniform sampler2D g_Volumetric;
layout(set = 0, binding = 1, r11f_g11f_b10f) uniform writeonly image2D g_Result;

shared vec3 s_Tile[TILE_SIZE][TILE_SIZE]; // [y][x]

const float s_Kernel[KERNEL_SIZE] = float[](1.f / 8.f, 2.f / 8.f, 2.f / 8.f, 2.f / 8.f, 1.f / 8.f);

void main()
{
    const ivec2 tileOrigin = ivec2(gl_WorkGroupID.xy) * GROUP_SIZE - KERNEL_RADIUS;
    for (uint i = gl_LocalInvocationIndex; i < TILE_SIZE * TILE_SIZE; i += GROUP_SIZE * GROUP_SIZE)
    {
        const ivec2 tileCoords = ivec2(i % TILE_SIZE, i / TILE_SIZE);
        const ivec2 pixel = clamp(tileOrigin + tileCoords, ivec2(0), g_Size - 1);
        s_Tile[tileCoords.y][tileCoords.x] = texelFetch(g_Volumetric, pixel, 0).rgb;
    }
    barrier();

    const ivec2 pixelCoords = ivec2(gl_GlobalInvocationID);
    if (pixelCoords.x >= g_Size.x || pixelCoords.y >= g_Size.y)
        return;

    const ivec2 localCoords = ivec2(gl_LocalInvocationID.xy) + KERNEL_RADIUS;
    vec3 result = vec3(0.f);
    float weightsSum = 0.f;
    for (int y = -KERNEL_RADIUS; y <= KERNEL_RADIUS; ++y)
    {
        for (int x = -KERNEL_RADIUS; x <= KERNEL_RADIUS; ++x)
        {
            const ivec2 neighbor = pixelCoords + ivec2(x, y);
            if (any(lessThan(neighbor, ivec2(0))) || any(greaterThanEqual(neighbor, g_Size)))
                continue;

            const float weight = s_Kernel[x + KERNEL_RADIUS] * s_Kernel[y + KERNEL_RADIUS];
            result += weight * s_Tile[localCoords.y + y][localCoords.x + x];
            weightsSum += weight;
        }
    }

    imageStore(g_Result, pixelCoords, vec4(result / weightsSum, 1.f));
}
