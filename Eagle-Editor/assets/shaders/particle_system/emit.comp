struct DecompositedTransform
{
	vec2 Scale;
	float RotationZ; // Radians
	float Padding0;
};

layout(binding = 0) buffer PS_Data
{
    ParticleSystemData g_Data;
};

layout(binding = 1) buffer PackedParticles
{
    PackedParticle g_Particles[];
};

layout(binding = 2) readonly buffer Emitters
{
    Emitter g_Emitters[];
};

layout(binding = 3) buffer DeadIndices
{
    uint g_DeadIndices[];
};

layout(binding = 4) buffer AliveIndicesPreSim
{
    uint g_AliveIndicesPreSim[];
};

layout(binding = 5) readonly buffer EmittersSpawnCountBuffer
{
    uint g_EmittersSpawnCount[];
};

layout(binding = 6) readonly buffer TransformsBuffer
{
    mat4 g_Transforms[];
};

layout(binding = 7) readonly buffer StaticMeshVerticesBuffer
{
    StaticMeshVertex g_StaticVertices[];
};

layout(binding = 8) readonly buffer StaticMeshIndicesBuffer
{
    uint g_StaticIndices[];
};

layout(binding = 9) readonly buffer SkeletalMeshVerticesBuffer
{
    SkeletalMeshVertex g_SkeletalVertices[];
};

layout(binding = 10) readonly buffer SkeletalMeshIndicesBuffer
{
    uint g_SkeletalIndices[];
};

layout(binding = 11) readonly buffer SkeletalMeshAnimations
{
    mat4 g_Animations[];
};

layout(binding = 12) readonly buffer DecompositedTransformsBuffer
{
    DecompositedTransform g_DecompositedTransforms[];
};

layout(push_constant) uniform PushConstants
{
    uint g_PreSimIndex;
    uint g_FrameNumber;
    uint g_NumEmitters;
    uint g_MaxParticles;
};

void PushAlive(uint particleIndex)
{
    uint insertIdx;
    EG_SUBGROUP_ATOMIC_INCREMENT(g_Data.AliveCount[g_PreSimIndex], true, insertIdx);
    g_AliveIndicesPreSim[insertIdx] = particleIndex;
}

// Returns false if there are no slots available
bool PopDead(out uint particleIndex)
{
    uint index, origDeadCount;
    EG_SUBGROUP_ATOMIC_DECREMENT(g_Data.DeadCount, true, index, origDeadCount);
    if (index == 0 || index > origDeadCount || origDeadCount > g_MaxParticles) // `origDeadCount > g_MaxParticles` - Someone overflowed, which means there are no slots available
    {
        // Overflow, ignore particle emission
        EG_SUBGROUP_ATOMIC_INCREMENT(g_Data.DeadCount, true, index);
        return false;
    }
    particleIndex = g_DeadIndices[index - 1];
    return true;
}

// TODO: Improve
uint GetEmitterIndex(uint id)
{
    for (uint i = 0; i < g_NumEmitters; ++i)
    {
        if (id < g_EmittersSpawnCount[i])
            return i;
        id -= g_EmittersSpawnCount[i];
    }
}

vec3 NormalTowardClosestFace(vec3 point, vec3 aabbMin, vec3 aabbMax)
{
    // Distance to each face
    float dxMin = point.x - aabbMin.x;
    float dxMax = aabbMax.x - point.x;
    float dyMin = point.y - aabbMin.y;
    float dyMax = aabbMax.y - point.y;
    float dzMin = point.z - aabbMin.z;
    float dzMax = aabbMax.z - point.z;

    // Find the smallest distance
    float minDist = dxMin;
    vec3 normal = vec3(-1, 0, 0);

    if (dxMax < minDist) { minDist = dxMax; normal = vec3(1,  0,  0); }
    if (dyMin < minDist) { minDist = dyMin; normal = vec3(0, -1,  0); }
    if (dyMax < minDist) { minDist = dyMax; normal = vec3(0,  1,  0); }
    if (dzMin < minDist) { minDist = dzMin; normal = vec3(0,  0, -1); }
    if (dzMax < minDist) { minDist = dzMax; normal = vec3(0,  0,  1); }

    return normal;
}

void GetPosAndNormalOnStaticMesh(Emitter emitter, inout Random random, inout vec3 pos, inout vec3 normal)
{
    // random triangle on emitter surface
	const uint triangleCount = emitter.IndexCount / 3;
	const uint tri = Random_NextUint(random, triangleCount);

	// load indices of triangle from index buffer
	uint i0 = g_StaticIndices[emitter.IndexOffset + tri * 3 + 0];
	uint i1 = g_StaticIndices[emitter.IndexOffset + tri * 3 + 1];
	uint i2 = g_StaticIndices[emitter.IndexOffset + tri * 3 + 2];

	// load vertices of triangle from vertex buffer
    StaticMeshVertex v0 = g_StaticVertices[emitter.VertexOffset + i0];
    StaticMeshVertex v1 = g_StaticVertices[emitter.VertexOffset + i1];
    StaticMeshVertex v2 = g_StaticVertices[emitter.VertexOffset + i2];

    // random barycentric coords
    vec2 buv = Random_NextFloat2(random);
	if (buv.x + buv.y > 1.f)
	{
		buv.x = 1.f - buv.x;
		buv.y = 1.f - buv.y;
	}
	
    // compute final surface position on triangle from barycentric coords:
	pos = BarycentricInterp(v0.Position, v1.Position, v2.Position, buv);
	normal = normalize(BarycentricInterp(Particle_UnpackNormal(v0.Normal), Particle_UnpackNormal(v1.Normal), Particle_UnpackNormal(v2.Normal), buv));
}

void GetPosAndNormalOnSkeletalMesh(Emitter emitter, inout Random random, inout vec3 pos, inout vec3 normal)
{
    // random triangle on emitter surface
	const uint triangleCount = emitter.IndexCount / 3;
	const uint tri = Random_NextUint(random, triangleCount);

	// load indices of triangle from index buffer
	uint i0 = g_SkeletalIndices[emitter.IndexOffset + tri * 3 + 0];
	uint i1 = g_SkeletalIndices[emitter.IndexOffset + tri * 3 + 1];
	uint i2 = g_SkeletalIndices[emitter.IndexOffset + tri * 3 + 2];

	// load vertices of triangle from vertex buffer
    SkeletalMeshVertex vertices[3];
    vertices[0] = g_SkeletalVertices[emitter.VertexOffset + i0];
    vertices[1] = g_SkeletalVertices[emitter.VertexOffset + i1];
    vertices[2] = g_SkeletalVertices[emitter.VertexOffset + i2];
    vec3 normals[3];

    for (uint vI = 0; vI < 3; vI++)
    {
        mat4 boneTransform = mat4(0.f);
        for (uint i = 0; i < 4; ++i)
        {
            const float animWeight = GetWeight(vertices[vI].Weights, i);
            if (animWeight > 0.f)
            {
                uint boneID = GetBoneID(vertices[vI].BoneIDs, i);
                boneTransform += g_Animations[emitter.AnimationOffset + boneID] * animWeight;
            }
        }
        vertices[vI].Position = vec3(boneTransform * vec4(vertices[vI].Position, 1.0));
        normals[vI] = mat3(boneTransform) * Particle_UnpackNormal(vertices[vI].Normal);
    }

    // random barycentric coords
    vec2 buv = Random_NextFloat2(random);
	if (buv.x + buv.y > 1.f)
	{
		buv.x = 1.f - buv.x;
		buv.y = 1.f - buv.y;
	}
	
    // compute final surface position on triangle from barycentric coords:
	pos = BarycentricInterp(vertices[0].Position, vertices[1].Position, vertices[2].Position, buv);
	normal = normalize(BarycentricInterp(normals[0], normals[1], normals[2], buv));
}

void Emitter_GetParticlePositionAndNormal(Emitter emitter, inout Random random, out vec3 position, out vec3 normal)
{
	position = vec3(0);
	normal = vec3(0);
	switch (emitter.EmissionShape)
	{
		// case EmissionShapeType_Point: return; // Returns 0
		case EmissionShapeType_Sphere:
			position = Random_PointInSphere(random, emitter.SphereRadius);
            normal = normalize(position);
			break;
		case EmissionShapeType_SphereSurface:
			position = Random_PointOnSphere(random, emitter.SphereRadius);
            normal = normalize(position);
			break;
		case EmissionShapeType_Box:
        {
            position = mix(emitter.BoxMin, emitter.BoxMax, Random_NextFloat3(random));
            normal = NormalTowardClosestFace(position, emitter.BoxMin, emitter.BoxMax);
            break;
        }
		case EmissionShapeType_BoxSurface:
        {
            float dx = emitter.BoxMax.x - emitter.BoxMin.x;
            float dy = emitter.BoxMax.y - emitter.BoxMin.y;
            float dz = emitter.BoxMax.z - emitter.BoxMin.z;

            // Areas of the 3 face pairs
            float areaXY = dx * dy;
            float areaXZ = dx * dz;
            float areaYZ = dy * dz;

            // Choose face weighted by area
            float totalArea = 2.0f * (areaXY + areaXZ + areaYZ);
            float pick = Random_NextFloat(random) * totalArea;

            if (pick < areaXY * 2)
            {
                // Z faces
                bool positive = (pick < areaXY);
                float x = emitter.BoxMin.x + Random_NextFloat(random) * dx;
                float y = emitter.BoxMin.y + Random_NextFloat(random) * dy;
                float z = positive ? emitter.BoxMax.z : emitter.BoxMin.z;
                position = vec3(x, y, z);
                normal = vec3(0, 0, positive ? 1 : -1);
            }
            else if (pick < (areaXY * 2 + areaXZ * 2))
            {
                // Y faces
                bool positive = (pick < areaXY * 2 + areaXZ);
                float x = emitter.BoxMin.x + Random_NextFloat(random) * dx;
                float y = positive ? emitter.BoxMax.y : emitter.BoxMin.y;
                float z = emitter.BoxMin.z + Random_NextFloat(random) * dz;
                position = vec3(x, y, z);
                normal = vec3(0, positive ? 1 : -1, 0);
            }
            else
            {
                // X faces
                bool positive = (pick < areaXY * 2 + areaXZ * 2 + areaYZ);
                float x = positive ? emitter.BoxMax.x : emitter.BoxMin.x;
                float y = emitter.BoxMin.y + Random_NextFloat(random) * dy;
                float z = emitter.BoxMin.z + Random_NextFloat(random) * dz;
                position = vec3(x, y, z);
                normal = vec3(positive ? 1 : -1, 0, 0);
            }
			break;
        }
		case EmissionShapeType_Ring:
			position = Random_PointInRing(random, emitter.RingRadius, emitter.RingThickness, normal);
			break;
		case EmissionShapeType_Mesh:
            if (emitter.AnimationOffset != -1)
			    GetPosAndNormalOnSkeletalMesh(emitter, random, position, normal);
            else
			    GetPosAndNormalOnStaticMesh(emitter, random, position, normal);
			break;
	}
}

layout(local_size_x = EG_PS_THREAD_SIZE, local_size_y = 1, local_size_z = 1) in;

void main()
{
    const uint gidx = gl_GlobalInvocationID.x;
    if (gidx >= g_Data.EmitCount)
        return;

    uint particleIndex;
    if (!PopDead(particleIndex))
        return;

    const uint emitterIndex = GetEmitterIndex(gidx);
    const Emitter emitter = g_Emitters[emitterIndex];

    Random random = Random_Init(uvec2(0, gidx), g_FrameNumber);

    const mat4 worldTr = g_Transforms[emitter.TransformIndex];

    vec3 position, normal;
    Emitter_GetParticlePositionAndNormal(emitter, random, position, normal);
    position = vec3(worldTr * vec4(position, 1.f));

    const float bounciness = mix(emitter.BouncinessMin, emitter.BouncinessMax, Random_NextFloat(random));
    const float opacity = emitter.ColorStart.a;

    Particle particle;
    particle.Size = emitter.SizeStart.xy;
    particle.CurrentLifetime = 0.f;
    particle.Lifetime = mix(emitter.LifetimeMin, emitter.LifetimeMax, Random_NextFloat(random));

    particle.Position = position;
    particle.Flags = EmitterFlagsToParticleFlags(emitter.Flags);

    particle.Velocity = normal * emitter.NormalVelocityFactor + mix(emitter.VelocityMin, emitter.VelocityMax, Random_NextFloat3(random));
    particle.Bounciness = bounciness;
    particle.RotationZ = emitter.RotationZStart;

    particle.VelocityCoef = emitter.VelocityCoefStart;
    particle.EmitterIndex = emitterIndex;

    particle.Color = emitter.ColorStart;
    particle.TextureIndex = emitter.TextureIndex;
    particle.AnimationSpriteCoord = uvec2(0);
    particle.AnimationLerp = 0.0f;

    DecompositedTransform decompositedTr = g_DecompositedTransforms[emitter.TransformIndex];
    particle.SizeScale = decompositedTr.Scale;
    particle.RotationZOffset = decompositedTr.RotationZ;

    g_Particles[particleIndex] = Particle_Pack(particle, emitter.AnimationImagesNum);
    PushAlive(particleIndex);
}
