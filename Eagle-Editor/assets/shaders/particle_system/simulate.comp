#include "particle_system/common.h"
#include "utils.h"

layout(binding = 0) buffer PS_Data
{
    ParticleSystemData g_Data;
};

layout(binding = 1) buffer PackedParticles
{
    PackedParticle g_Particles[];
};

layout(binding = 2) readonly buffer Emitters
{
    Emitter g_Emitters[];
};

layout(binding = 3) buffer DeadIndices
{
    uint g_DeadIndices[];
};

layout(binding = 4) readonly buffer AliveIndicesPreSim
{
    uint g_AliveIndicesPreSim[];
};

layout(binding = 5) buffer AliveIndicesPostSim
{
    uint g_AliveIndicesPostSim[];
};

layout(binding = 6) buffer IndicesToRenderTranslucentBuffer
{
    uint g_IndicesToRenderTranslucent[];
};

layout(binding = 7) buffer DistancesTranslucentBuffer
{
    uint g_DistancesTranslucent[];
};

layout(binding = 8) buffer DrawArgsBuffer
{
    DrawArgs g_DrawArgs[2];
};

layout(binding = 9)  uniform sampler2D g_Depth;
layout(binding = 10) uniform sampler2D g_Normal;

layout(binding = 11) uniform CameraView
{
	mat4 g_CameraView;
};

layout(binding = 12) readonly buffer EmitterCurvesBuffer
{
    vec4 g_EmitterCurves[];
};

layout(binding = 13) readonly buffer DecompositedTransformsBuffer
{
    DecompositedTransform g_DecompositedTransforms[];
};

layout(binding = 14) buffer ParticleEventsBuffer
{
    uint g_EventsCount[2]; // Events written into each half
    uint g_EventsPadding0;
    uint g_EventsPadding1;
    ParticleEvent g_Events[]; // Split into two halves (ping-pong)
};

// `Emitter_MaxSubEmitters` links per emitter slot
layout(binding = 15) readonly buffer SubEmitterLinksBuffer
{
    SubEmitterLink g_SubEmitterLinks[];
};

layout(binding = 16) buffer IndicesToRenderOpaqueBuffer
{
    uint g_IndicesToRenderOpaque[];
};

#ifdef EG_SORT_OPAQUE
layout(binding = 17) buffer DistancesOpaqueBuffer
{
    uint g_DistancesOpaque[];
};
#endif

layout(push_constant) uniform PushConstants
{
    mat4 g_ViewProj;

    vec3 g_Gravity;
    float g_CameraNear;

    float g_CameraFar;
    float g_DeltaTime;
    uint g_PreSimIndex;
    uint g_PostSimIndex;
    uint g_MaxParticles;
};

vec4 SampleEmitterCurve(uint emitterIndex, uint curve, float lifeAlpha)
{
    uint index0, index1;
    float blend;
    EmitterCurve_GetSamples(emitterIndex, curve, lifeAlpha, index0, index1, blend);
    return mix(g_EmitterCurves[index0], g_EmitterCurves[index1], blend);
}

void PushAlive(uint particleIndex)
{
    uint insertIdx;
    EG_SUBGROUP_ATOMIC_INCREMENT(g_Data.AliveCount[g_PostSimIndex], true, insertIdx);
    g_AliveIndicesPostSim[insertIdx] = particleIndex;
}

// Returns false if there are no slots available
bool PopAlive(out uint particleIndex)
{
    uint index, origAliveCount;
    EG_SUBGROUP_ATOMIC_DECREMENT(g_Data.AliveCount[g_PreSimIndex], true, index, origAliveCount);
    if (index == 0 || index > origAliveCount || origAliveCount > g_MaxParticles) // `origAliveCount > g_MaxParticles` - Someone overflowed, which means there are no slots available
    {
        // Overflow, ignore particle emission
        EG_SUBGROUP_ATOMIC_INCREMENT(g_Data.AliveCount[g_PreSimIndex], true, index);
        return false;
    }
    particleIndex = g_AliveIndicesPreSim[index - 1];
    return true;
}

// Writes a sub-emitter event for every link of the particle's emitter that reacts to `trigger`.
// The next frame's `emit` spawns the particles
void TriggerSubEmitters(uint trigger, Particle particle, uint particleIndex)
{
    const uint emitterIndex = Particle_GetEmitterIndex(particle.EmitterRef);
    const Emitter emitter = g_Emitters[emitterIndex];
    if (!HasFlag(emitter.Flags, Emitter_HasSubEmitters_Mask) || Particle_GetEmitterGeneration(particle.EmitterRef) != (emitter.Generation & Emitter_GenerationMask))
        return;

    Random random = Random_Init(uvec2(particleIndex, floatBitsToUint(particle.Lifetime)), floatBitsToUint(particle.Position.x) ^ floatBitsToUint(particle.Position.z));
    for (uint i = 0; i < Emitter_MaxSubEmitters; ++i)
    {
        const SubEmitterLink link = g_SubEmitterLinks[emitterIndex * Emitter_MaxSubEmitters + i];
        if (link.Trigger != trigger || Random_NextFloat(random) >= link.Probability)
            continue;

        const uint countRange = link.CountMax - link.CountMin;
        const uint count = link.CountMin + min(uint(Random_NextFloat(random) * float(countRange + 1u)), countRange);
        if (count == 0u)
            continue;

        const uint slot = atomicAdd(g_EventsCount[g_PreSimIndex], 1u);
        if (slot >= ParticleEvents_Capacity)
            continue; // Too many events this frame

        ParticleEvent particleEvent;
        particleEvent.Position = particle.Position;
        particleEvent.EmitterRef = link.TargetEmitterRef;
        particleEvent.Velocity = particle.EffectiveVelocity * link.InheritVelocity;
        particleEvent.Count = count;
        particleEvent.Color = HasFlag(link.Flags, SubEmitter_InheritColor_Mask) ? particle.Color : vec4(1.f);
        g_Events[g_PreSimIndex * ParticleEvents_Capacity + slot] = particleEvent;
    }
}

// Per-particle culling. A sphere around the particle against this frame's culling frustum, in view space
// (the same frustum as `FrustumAABBIntersection`)
bool Particle_IsInFrustum(vec3 worldPos, float radius)
{
    const vec3 p = vec3(g_Data.CullingView * vec4(worldPos, 1.f));
    const float xNear = g_Data.CullingFrustum.x;
    const float yNear = g_Data.CullingFrustum.y;
    const float zNear = g_Data.CullingFrustum.z; // Negative
    const float zFar = g_Data.CullingFrustum.w;  // Negative, smaller than `zNear`

    if (p.z - radius > zNear || p.z + radius < zFar)
        return false;

    // The side planes go through the eye. Inside: `dot(normal, p) >= 0` (normals point inwards, not normalized)
    const float lengthX = length(vec2(zNear, xNear));
    const float lengthY = length(vec2(zNear, yNear));
    return dot(vec3(zNear, 0.f, -xNear), p) >= -radius * lengthX   // Right
        && dot(vec3(-zNear, 0.f, -xNear), p) >= -radius * lengthX  // Left
        && dot(vec3(0.f, zNear, -yNear), p) >= -radius * lengthY   // Top
        && dot(vec3(0.f, -zNear, -yNear), p) >= -radius * lengthY; // Bottom
}

void PushDead(uint particleIndex)
{
    uint insertIdx;
    EG_SUBGROUP_ATOMIC_INCREMENT(g_Data.DeadCount, true, insertIdx);
    g_DeadIndices[insertIdx] = particleIndex;
}

// The sort is ascending. `viewZ` is negative in front of the camera.
// For opaque: key = `-viewZ` -> front-to-back
// For translucent: key = `viewZ` -> back-to-front
void PushToDrawOpaque(uint particleIndex, float viewZ)
{
    uint insertIdx;
    EG_SUBGROUP_ATOMIC_INCREMENT(g_DrawArgs[0].InstanceCount, true, insertIdx);
    g_IndicesToRenderOpaque[insertIdx] = particleIndex;
#ifdef EG_SORT_OPAQUE
    g_DistancesOpaque[insertIdx] = FloatToSortableUint(-viewZ);
#endif
}

void PushToDrawTranslucent(uint particleIndex, float viewZ)
{
    uint insertIdx;
    EG_SUBGROUP_ATOMIC_INCREMENT(g_DrawArgs[1].InstanceCount, true, insertIdx);
    g_IndicesToRenderTranslucent[insertIdx] = particleIndex;
    g_DistancesTranslucent[insertIdx] = FloatToSortableUint(viewZ);
}

layout(local_size_x = EG_PS_THREAD_SIZE, local_size_y = 1, local_size_z = 1) in;

void main()
{
    const uint gidx = gl_GlobalInvocationID.x;
    if (gidx >= g_Data.SimulateCount)
        return;

    uint particleIndex;
    if (!PopAlive(particleIndex))
        return;

    Particle particle = Particle_Unpack(g_Particles[particleIndex]);

    // Age first. A particle that reaches its lifetime during this step is neither simulated nor drawn.
    // So nothing is drawn past its lifetime, the number of alive particles matches `spawn rate * lifetime`,
    // But it has a side effect: particles that live less than one frame are no longer drawn at all
    particle.CurrentLifetime += g_DeltaTime;

    if (particle.CurrentLifetime >= particle.Lifetime)
    {
        TriggerSubEmitters(SubEmitterTrigger_Death, particle, particleIndex);
        PushDead(particleIndex);
        return;
    }

    const uint emitterIndex = Particle_GetEmitterIndex(particle.EmitterRef);
    const Emitter emitter = g_Emitters[emitterIndex];

    // The emitter slot was reused by another emitter, so this particle's emitter no longer exists
    if (Particle_GetEmitterGeneration(particle.EmitterRef) != (emitter.Generation & Emitter_GenerationMask))
    {
        PushDead(particleIndex);
        return;
    }

    if ((HasFlag(emitter.Flags, Emitter_Enabled_Mask) == false) && HasFlag(emitter.Flags, Emitter_DestroyImmediately_Mask))
    {
        PushDead(particleIndex);
        return;
    }

    // Local simulation space particles transform with the emitter.
    // Particles spawned this frame are already placed at the emitter's current transform, so they're ignored
    if (HasFlag(emitter.Flags, Emitter_LocalSimulation_Mask) && !HasFlag(particle.Flags, Particle_JustSpawned_Mask))
    {
        particle.Position = vec3(emitter.DeltaTransform * vec4(particle.Position, 1.f));
        particle.Velocity = mat3(emitter.DeltaTransform) * particle.Velocity;
    }

    const float lifeAlpha = particle.CurrentLifetime / particle.Lifetime;

    // xyz - velocity multiplier, w - drag
    const vec4 velocityCoefDrag = SampleEmitterCurve(emitterIndex, EmitterCurve_VelocityCoef_Drag, lifeAlpha);
    const float drag = velocityCoefDrag.w;

    const mat3 emitterRotation = DecompositedTransform_GetRotation(g_DecompositedTransforms[emitter.TransformIndex]);
    const vec4 velocityGravity = SampleEmitterCurve(emitterIndex, EmitterCurve_Velocity, lifeAlpha); // xyz - velocity over lifetime, w - gravity on/off
    const vec3 velocityOverLife = velocityGravity.xyz;
    const float gravitySample = velocityGravity.w;
    const vec3 gravity = gravitySample >= 0.5f ? g_Gravity : vec3(0.f);

    const vec2 turbulence = HasFlag(emitter.Flags, Emitter_HasTurbulence_Mask) ? SampleEmitterCurve(emitterIndex, EmitterCurve_Turbulence, lifeAlpha).xy : vec2(0.f);
    particle.Velocity += Particle_ComputeForce(emitter, particle.Position, emitterRotation, gravity, emitter.NoiseOffset, turbulence) * g_DeltaTime;
    Particle_ApplyDrag(particle.Velocity, drag, g_DeltaTime);

    if (emitter.CollisionType != ParticleCollisionType_None)
    {
        vec4 position = g_ViewProj * vec4(particle.Position, 1.0);
        if (position.w > 0.f)
        {
            position.xyz /= position.w;

            const vec2 uv = position.xy * 0.5 + vec2(0.5);
            if (uv.x >= 0.f && uv.y >= 0.f && uv.x <= 1.f && uv.y <= 1.f)
            {
                const vec3 normal = DecodeNormal(texture(g_Normal, uv).xy); // .xy - Geometry Normal
                const float depth = ToLinear(texture(g_Depth, uv).x, g_CameraNear, g_CameraFar);
                const vec2 particleSize = particle.Size * emitter.ColliderSizeRatio.xy;
                const float particleSizeMax = max(particleSize.x, particleSize.y);
                const float surfaceThickness = 1.5f;
                if ((position.w + particleSizeMax > depth) && (position.w - particleSizeMax < depth + surfaceThickness))
                {
                    if (dot(particle.Velocity, normal) < 0.0)
                    {
                        switch (emitter.CollisionType)
                        {
                            case ParticleCollisionType_DestroyOnHit:
                                TriggerSubEmitters(SubEmitterTrigger_Collision, particle, particleIndex);
                                TriggerSubEmitters(SubEmitterTrigger_Death, particle, particleIndex);
                                PushDead(particleIndex);
                                return;
                            case ParticleCollisionType_Bounce:
                                TriggerSubEmitters(SubEmitterTrigger_Collision, particle, particleIndex);
                                particle.Velocity = reflect(particle.Velocity, normal) * particle.Bounciness; 
                                break;
                        }
                    }
                }
            }
        }
    }

    // Handle animation
    float animationLerp = 0.f;
    if (emitter.TextureIndex != EG_INVALID_INDEX)
    {
        const float animationFPS = emitter.AnimationSpeed * float(emitter.AnimationImagesNum.x * emitter.AnimationImagesNum.y) / particle.Lifetime;
        const float previousLifetime = max(particle.CurrentLifetime - g_DeltaTime, 0.f);
        const uint advanceAnimationCount = uint(particle.CurrentLifetime * animationFPS) - uint(previousLifetime * animationFPS);
        animationLerp = fract(particle.CurrentLifetime * animationFPS);

        Particle_AdvanceAnimationBy(particle.AnimationSpriteCoord, emitter.AnimationImagesNum, advanceAnimationCount);
    }

    const vec4 sizeRotation = SampleEmitterCurve(emitterIndex, EmitterCurve_SizeRotation, lifeAlpha);
    // The particle's own spin (random speed, constant over its life) and the spin from the rotation speed curve are added on top
    // of the rotation curve. The curve's spin is baked as an integral over the normalized lifetime, so it's scaled by the lifetime
    const float spin = particle.RotationSpeed * particle.CurrentLifetime + sizeRotation.w * particle.Lifetime;
    const float rotationZ = mod(sizeRotation.z + spin - particle.RotationZOffset, EG_2PI);
    const vec3 velocityCoef = velocityCoefDrag.xyz;

    const bool bWorldSpaceVelocity = HasFlag(emitter.Flags, Emitter_WorldSpaceVelocity_Mask);
    // Plus the velocity over lifetime. It's not added to `particle.Velocity`, so it doesn't accumulate.
    const vec3 velocityOverLifetime = Particle_VelocityOverLifetimeToWorld(velocityOverLife, emitterRotation, bWorldSpaceVelocity);
    const vec3 velocity = ApplyVelocityCoef(particle.Velocity + velocityOverLifetime, velocityCoef, emitterRotation, bWorldSpaceVelocity);

    particle.Size = sizeRotation.xy * particle.SizeScale;
    particle.Position += velocity * g_DeltaTime;
    particle.Flags = EmitterFlagsToParticleFlags(emitter.Flags);
    particle.RotationZ = rotationZ;
    particle.EffectiveVelocity = velocity;
    particle.Color = SampleEmitterCurve(emitterIndex, EmitterCurve_Color, lifeAlpha) * mix(emitter.RandomTintA, emitter.RandomTintB, particle.TintFactor) * particle.InheritedColor;
    particle.TextureIndex = emitter.TextureIndex;
    particle.AnimationLerp = animationLerp;

    g_Particles[particleIndex] = Particle_Pack(particle, emitter.AnimationImagesNum);
    PushAlive(particleIndex);

    const bool bVisible = HasFlag(emitter.Flags, Emitter_PerParticleCulling_Mask)
        ? Particle_IsInFrustum(particle.Position, 0.5f * length(particle.Size)) // Half the quad's diagonal
        : Emitter_IsVisible(emitter);
    if (bVisible)
    {
        const vec4 viewPos = g_CameraView * vec4(particle.Position, 1.0);
        if (HasFlag(emitter.Flags, Emitter_AlphaBlending_Mask))
            PushToDrawTranslucent(particleIndex, viewPos.z);
        else
            PushToDrawOpaque(particleIndex, viewPos.z);
    }
}
