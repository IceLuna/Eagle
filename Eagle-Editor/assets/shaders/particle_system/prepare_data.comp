#include "particle_system/common.h"
#include "utils.h"

layout(binding = 0) buffer PS_Data
{
    ParticleSystemData g_Data;
};

layout(binding = 1) buffer DrawArgsBuffer
{
    DrawArgs g_DrawArgs[2];
};

layout(binding = 2) buffer DispatchArgsBuffer
{
    uvec4 g_EmitArgs;
    uvec4 g_SimulateArgs;
};

layout(binding = 3) buffer EmittersBuffer
{
    Emitter g_Emitters[];
};

// Exclusive prefix sum of spawn counts per emitter
layout(binding = 4) buffer EmitterSpawnOffsetsBuffer
{
    uint g_EmittersSpawnOffsets[];
};

layout(binding = 5) readonly buffer EmitterTransforms
{
    mat4 g_Transforms[];
};

layout(push_constant) uniform PushConstants
{
    mat4 g_View;
    uint g_PreSimIndex;
    uint g_PostSimIndex;
    uint g_NumEmitters;
    float g_DeltaTime;
    uint g_MaxParticles;
    CullingFrustum g_Frustum;
};

#define GROUP_SIZE 32

shared uint s_EmitCount[GROUP_SIZE]; // Per-thread emit count. After the scan - per-thread exclusive offset
shared uint s_TotalEmitCount;
shared uint s_AvailableSlots;

// Tries to reserve up to `amount` particle slots.
// Returns the number of reserved slots
uint ReserveSlots(uint amount, bool bAllowPartial)
{
    if (amount == 0)
        return 0;

    // Atomic CAS loop
    while (true)
    {
        const uint oldVal = s_AvailableSlots;
        const uint reserved = min(oldVal, amount);
        if (reserved == 0 || (!bAllowPartial && reserved < amount))
            return 0;

        // If s_AvailableSlots == oldVal, it becomes (oldVal - reserved) and CAS returns oldVal.
        // Otherwise another thread modified s_AvailableSlots, so retry
        if (atomicCompSwap(s_AvailableSlots, oldVal, oldVal - reserved) == oldVal)
            return reserved;
    }

    return 0;
}

// Emits every particle that would be alive if the emitter had been running for `FastForwardTime` seconds,
// and moves the emitter's own state (spawn timer, loops) to that point in time.
// The particles themselves are advanced in `emit` pass
uint FastForwardEmitter(inout Emitter emitter)
{
    const float time = emitter.FastForwardTime;
    const bool bExplode = HasFlag(emitter.Flags, Emitter_Explode_Mask);
    const float eventsPerSecond = bExplode ? (1.f / emitter.LoopDuration) : float(emitter.SpawnRate);
    const float particlesPerEvent = bExplode ? float(emitter.SpawnRate) : 1.f;

    const float lastDeadEvent = floor((time - emitter.LifetimeMax) * eventsPerSecond);

    // Spawn events older than `LifetimeMax` can't have alive particles
    const float firstSpawnEventIndex = max(lastDeadEvent + 1.f, 0.f);
    const float lastSpawnEventIndex = FastForward_LastSpawnEventIndex(emitter, bExplode);
    
    float requested = max(lastSpawnEventIndex - firstSpawnEventIndex + 1, 0) * particlesPerEvent;
    requested = min(requested, float(s_AvailableSlots)); // Safery guard against crasy high `requested` values before converting to `uint`
    const uint count = ReserveSlots(uint(requested), true);

    emitter.SpawnIntervalTimer = time - FastForward_SpawnEventTime(emitter, bExplode, lastSpawnEventIndex); // Time since the last spawn
    if (bExplode)
    {
        emitter.LoopIteration = emitter.LoopCount != 0 ? (uint(lastSpawnEventIndex) + 1u) : 0u; // One explosion is one loop iteration
        emitter.DeltaTime = 0.f;
    }
    else
    {
        const uint loopsPassed = uint(time / emitter.LoopDuration);
        emitter.LoopIteration = emitter.LoopCount != 0 ? min(loopsPassed, emitter.LoopCount) : 0u;
        emitter.DeltaTime = time - loopsPassed * emitter.LoopDuration;
    }
    Emitter_SetWasExplode(emitter, bExplode);
    Emitter_SetFastForwardEnabled(emitter, true); // Tells `emit` pass to fast-forward this emitter's particles. Cleared next frame
    return count;
}

layout(local_size_x = GROUP_SIZE, local_size_y = 1, local_size_z = 1) in;

void main()
{
    const uint lid = gl_LocalInvocationIndex;
    s_EmitCount[lid] = 0;
    if (lid == 0)
    {
        s_AvailableSlots = g_MaxParticles - g_Data.AliveCount[g_PreSimIndex];
    }
    barrier();

    const uint emittersPerThread = CalcNumGroups(g_NumEmitters, GROUP_SIZE);
    const uint firstEmitter = min(lid * emittersPerThread, g_NumEmitters);
    const uint endEmitter = min(firstEmitter + emittersPerThread, g_NumEmitters);
    for (uint i = firstEmitter; i < endEmitter; ++i)
    {
        Emitter emitter = g_Emitters[i];

        // Visibility and world position are updated even for disabled emitters, because their particles can still be alive
        const mat4 emitterTr = g_Transforms[emitter.TransformIndex];
        const bool bVisible = FrustumAABBIntersection(g_Frustum, g_View * emitterTr, emitter.AABBMin, emitter.AABBMax);
        Emitter_SetIsVisible(emitter, bVisible);
        emitter.WorldPos = vec3(emitterTr[3][0], emitterTr[3][1], emitterTr[3][2]);

        const mat3 emitterRotation = ExtractRotation(emitterTr);
        emitter.RotationColumn0 = emitterRotation[0];
        emitter.RotationColumn1 = emitterRotation[1];
        emitter.RotationColumn2 = emitterRotation[2];

        // The fast-forward batch was emitted last frame, disable it
        if (Emitter_IsFastForwardEnabled(emitter))
        {
            Emitter_SetFastForwardEnabled(emitter, false);
            emitter.FastForwardTime = 0.f;
        }

        if (emitter.LoopCount == 0)
            emitter.LoopIteration = 0u;

        uint count = 0;
        const bool bEnabled = HasFlag(emitter.Flags, Emitter_Enabled_Mask) && (emitter.LoopCount == 0 || emitter.LoopIteration < emitter.LoopCount);
        if (!bEnabled)
        {
            emitter.FastForwardTime = 0.f; // Only applies to an emitter that is enabled when it's added
        }
        else if (emitter.FastForwardTime > 0.f)
        {
            count = FastForwardEmitter(emitter);
        }
        else
        {
            const bool bExplode = HasFlag(emitter.Flags, Emitter_Explode_Mask);
            if (bExplode && !Emitter_WasExplode(emitter))
            {
                emitter.SpawnIntervalTimer = 0.f; // Just entered explode mode. Reset the timer
                Emitter_SetWasExplode(emitter, true);
            }

            emitter.SpawnIntervalTimer += g_DeltaTime;

            // If no longer in explode mode, wait for all exploded particles to die
            const float spawnInterval = (bExplode || Emitter_WasExplode(emitter)) ? emitter.LoopDuration : 1.f / float(emitter.SpawnRate);
            if (emitter.SpawnIntervalTimer >= spawnInterval)
            {
                if (!bExplode && Emitter_WasExplode(emitter))
                {
                    // No longer in explode mode. We waited for all exploded particles to die.
                    // Restore the default spawn rate. Don't spawn anything this frame
                    Emitter_SetWasExplode(emitter, false);
                    emitter.SpawnIntervalTimer = 0.f;
                }
                else if (bExplode)
                {
                    // Only one explosion, even if several loop durations have passed (for example, after a stutter).
                    // Explosions don't catch up, only the time past the last whole loop duration is kept (0.5s with a 0.4s loop -> 0.1s)
                    count = ReserveSlots(emitter.SpawnRate, false);
                    if (count > 0)
                    {
                        if (emitter.LoopCount != 0)
                            emitter.LoopIteration += 1u;
                        emitter.DeltaTime = 0.f;
                        emitter.SpawnIntervalTimer = mod(emitter.SpawnIntervalTimer, spawnInterval);
                    }
                    else
                    {
                        // Not enough free slots. Try again next frame
                        emitter.SpawnIntervalTimer = spawnInterval;
                    }
                }
                else
                {
                    // Spawn as many as we can
                    const uint spawnTriggersCount = uint(emitter.SpawnIntervalTimer / spawnInterval);
                    count = ReserveSlots(spawnTriggersCount, true);
                    if (count > 0)
                    {
                        if (emitter.DeltaTime >= emitter.LoopDuration)
                        {
                            const uint iterationsPassed = uint(emitter.DeltaTime / emitter.LoopDuration);
                            if (emitter.LoopCount != 0)
                                emitter.LoopIteration += iterationsPassed;
                            emitter.DeltaTime -= emitter.LoopDuration * float(iterationsPassed);
                        }
                        emitter.SpawnIntervalTimer -= spawnInterval * float(count);
                    }

                    if (count < spawnTriggersCount)
                    {
                        // Not enough free slots. Reset the interval (keep at most one pending trigger)
                        // so that we don't get a burst once slots become available
                        emitter.SpawnIntervalTimer = min(emitter.SpawnIntervalTimer, spawnInterval);
                    }
                }
            }
            emitter.DeltaTime += g_DeltaTime;
        }

        g_Emitters[i] = emitter;
        g_EmittersSpawnOffsets[i] = count; // Temporarily stores the count. Converted to an offset below
        s_EmitCount[lid] += count;
    }

    barrier();

    // Exclusive scan of per-thread counts
    if (lid == 0)
    {
        uint sum = 0;
        for (uint t = 0; t < GROUP_SIZE; ++t)
        {
            const uint threadCount = s_EmitCount[t];
            s_EmitCount[t] = sum; // Reusing `s_EmitCount`
            sum += threadCount;
        }
        s_TotalEmitCount = sum;
    }

    barrier();

    // Convert this thread's per-emitter counts into global exclusive offsets.
    uint offset = s_EmitCount[lid];
    for (uint i = firstEmitter; i < endEmitter; ++i)
    {
        const uint emitterCount = g_EmittersSpawnOffsets[i];
        g_EmittersSpawnOffsets[i] = offset;
        offset += emitterCount;
    }

    if (lid == 0)
    {
        // Reset particle indirect draw instance count
        for (uint i = 0; i < 2; ++i)
        {
            g_DrawArgs[i].VertexCount   = 6;
            g_DrawArgs[i].InstanceCount = 0;
            g_DrawArgs[i].FirstVertex   = 0;
            g_DrawArgs[i].FirstInstance = 0;
        }

        g_Data.EmitCount = s_TotalEmitCount;
        g_EmitArgs.x = CalcNumGroups(g_Data.EmitCount, EG_PS_THREAD_SIZE);
        g_EmitArgs.y = 1;
        g_EmitArgs.z = 1;

        // Calculate total number of particles to simulate this frame
        g_Data.SimulateCount = g_Data.AliveCount[g_PreSimIndex] + g_Data.EmitCount;
        g_SimulateArgs.x = CalcNumGroups(g_Data.SimulateCount, EG_PS_THREAD_SIZE);
        g_SimulateArgs.y = 1;
        g_SimulateArgs.z = 1;

        // Reset post sim alive index count
        g_Data.AliveCount[g_PostSimIndex] = 0;
    }
}
